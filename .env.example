# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key

# Oeffentliche Adresse der Seite (fuer E-Mail-Bestaetigung), lokal http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: KI-Lernassistent (nur serverseitig, niemals mit NEXT_PUBLIC_ beginnen)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
